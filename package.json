{
  "name": "@philipseo/actions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "license": "MIT",
  "author": "Philip Seo <hbnb7894@gmail.com>",
  "homepage": "https://github.com/philipseo/actions",
  "repository": {
    "type": "git",
    "url": "https://github.com/philipseo/actions"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm build:slack-notify && pnpm build:upsert-test-coverage-comment",
    "build:slack-notify": "ncc build src/slack-notify/index.ts -m -o dist/slack-notify/",
    "build:upsert-test-coverage-comment": "ncc build src/upsert-test-coverage-comment/index.ts -m -o dist/upsert-test-coverage-comment/",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "lint": "pnpm eslint && pnpm prettier && pnpm typecheck",
    "lint:fix": "pnpm eslint:fix && pnpm prettier:fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/rest": "22.0.1",
    "@slack/web-api": "7.19.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@philipseo/configs": "0.1.2",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  }
}
